{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IBIS IV",
  "version": "0.1.0",
  "identifier": "io.ibis.iv",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "IBIS IV", "width": 1440, "height": 860,
        "minWidth": 1100, "minHeight": 680, "center": true }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "IBIS IV – Your stream. Your control.",
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installMode": "currentUser", "languages": ["German", "English"], "displayLanguageSelector": false }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "HIER_OEFFENTLICHEN_UPDATE_SCHLUESSEL_EINTRAGEN",
      "endpoints": ["https://github.com/DEIN-NAME/ibis-iv/releases/latest/download/latest.json"]
    }
  }
}
